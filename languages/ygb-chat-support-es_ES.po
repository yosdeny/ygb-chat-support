#: ygb-chat-support.php:87
msgid "Please wait before sending another message"
msgstr "Por favor, espera antes de enviar otro mensaje"

#: ygb-chat-support.php:118
msgid "Phone number must have between 10 and 15 digits (country code + number)."
msgstr "El número de teléfono debe tener entre 10 y 15 dígitos (código de país + número)."

#: ygb-chat-support.php:207
msgid "Chat with support"
msgstr "Chatear con soporte"

#: ygb-chat-support.php:241
msgid "How can we help you?"
msgstr "¿Cómo podemos ayudarte?"

#. translators: 1: User name, 2: Welcome message
#: ygb-chat-support.php:244
msgid "Hello %1$s, %2$s"
msgstr "Hola %1$s, %2$s"

#: ygb-chat-support.php:263
msgid "Open chat"
msgstr "Abrir chat"

#: ygb-chat-support.php:267
msgid "Chat icon"
msgstr "Icono de chat"

#: ygb-chat-support.php:277
msgid "Close chat"
msgstr "Cerrar chat"

#: ygb-chat-support.php:282
msgid "Chat Support"
msgstr "Soporte por chat"

#: ygb-chat-support.php:292
msgid "Type your message..."
msgstr "Escribe tu mensaje..."

#: ygb-chat-support.php:295
msgid "Start chat"
msgstr "Iniciar chat"

#: ygb-chat-support.php:418
msgid "Please type a message"
msgstr "Por favor, escribe un mensaje"

#: ygb-chat-support.php:454
msgid "You have sent too many messages. Please wait a few minutes."
msgstr "Has enviado demasiados mensajes. Por favor, espera unos minutos."

#: ygb-chat-support.php:471
msgid "Invalid or expired nonce"
msgstr "Nonce inválido o expirado"

#. translators: %d: Maximum allowed attempts
#: ygb-chat-support.php:491
msgid "You have exceeded the limit of %d messages. Please wait a few minutes."
msgstr "Has superado el límite de %d mensajes. Por favor, espera unos minutos."

#. translators: %d: Maximum message length
#: ygb-chat-support.php:506
msgid "Message is too long. Maximum %d characters."
msgstr "El mensaje es demasiado largo. Máximo %d caracteres."

#: ygb-chat-support.php:514
msgid "Message cannot be empty"
msgstr "El mensaje no puede estar vacío"

#: ygb-chat-support.php:536
msgid "Message contains prohibited content"
msgstr "El mensaje contiene contenido prohibido"

#: ygb-chat-support.php:540
msgid "Visitor"
msgstr "Visitante"

#. translators: %s: Site name
#: ygb-chat-support.php:557
msgid "🔔 Someone needs attention! - %s"
msgstr "🔔 ¡Alguien necesita atención! - %s"

#: ygb-chat-support.php:562
msgid "IMMEDIATE ATTENTION\n"
msgstr "ATENCIÓN INMEDIATA\n"

#: ygb-chat-support.php:565
msgid "👤 USER: %s\n"
msgstr "👤 USUARIO: %s\n"

