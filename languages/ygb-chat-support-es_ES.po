msgid "📧 EMAIL: %s\n"
msgstr "📧 CORREO: %s\n"

#: ygb-chat-support.php:572
msgid "💬 MESSAGE: %s\n"
msgstr "💬 MENSAJE: %s\n"

#: ygb-chat-support.php:573
msgid "📍 PAGE: %s\n"
msgstr "📍 PÁGINA: %s\n"

